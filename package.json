{
	"name": "manifold",
	"private": true,
	"version": "0.3.0",
	"description": "A private, self-hosted workspace for one person: services, notes, map notes and a vault, with a REST API and an MCP server.",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Rua-Systems/manifold.git"
	},
	"bugs": {
		"url": "https://github.com/Rua-Systems/manifold/issues"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && vite build --config vite.server.config.ts && vite build --config vite.cli.config.ts",
		"preview": "vite preview",
		"start": "node build/server.js",
		"cli": "node --env-file-if-exists=.env build-cli/cli.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . --max-warnings 0 && markdownlint-cli2",
		"format": "prettier --write .",
		"test": "npm run test:unit -- --run && npm run test:int && npm run test:e2e",
		"test:unit": "vitest --project unit",
		"test:int": "vitest run --project integration",
		"test:e2e": "playwright install chromium && playwright test",
		"db:up": "docker compose --env-file .env -f docker-compose.dev.yml up -d --wait",
		"db:down": "docker compose --env-file .env -f docker-compose.dev.yml down",
		"db:reset": "node scripts/db-reset.ts",
		"db:studio": "drizzle-kit studio",
		"sbom": "npm sbom --sbom-format cyclonedx --sbom-type application --omit dev"
	},
	"dependencies": {
		"@fontsource/space-mono": "^5.3.0",
		"@lucide/svelte": "^1.48.0",
		"@modelcontextprotocol/sdk": "^1.31.0",
		"@tiptap/core": "^3.31.3",
		"@tiptap/extension-bubble-menu": "^3.31.3",
		"@tiptap/extension-code-block-lowlight": "^3.31.3",
		"@tiptap/extension-image": "^3.31.3",
		"@tiptap/extension-list": "^3.31.3",
		"@tiptap/extension-table": "^3.31.3",
		"@tiptap/extensions": "^3.31.3",
		"@tiptap/markdown": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"better-auth": "^1.7.6",
		"drizzle-orm": "^0.45.3",
		"highlight.js": "^11.12.0",
		"lowlight": "^3.3.0",
		"nodemailer": "^10.0.12",
		"ol": "^10.10.0",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"tar": "^7.5.22",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.25.4",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24",
		"@types/nodemailer": "^8.0.2",
		"@types/qrcode": "^1.5.6",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"markdownlint-cli2": "^0.23.3",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.0",
		"sass": "^1.105.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		},
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.25.12"
		}
	}
}
