# Copy to `.env` in this folder. The app (`npm run dev`, the CLI, the tests) and both compose files
# read it. In Coolify, set the same variables in the service's environment settings instead.
# docs/configuration.md describes every variable.

# The image docker-compose.yml runs: `latest`, a release such as `0.1.0`, or a minor line such as
# `0.1`. `docker compose up --build` builds the image from this checkout instead.
MANIFOLD_VERSION=latest

# Public URL of the app without a trailing slash. Used for CSRF checks and as the auth base URL.
# http://localhost:5173 with `npm run dev`, the real https domain in production.
ORIGIN=http://localhost:5173

# Display name of this instance: page titles, sidebar header, sign in screens and mail.
# Defaults to Manifold.
ORGANIZATION_NAME=Manifold

# Credentials of the bundled PostGIS database (docker-compose.dev.yml and docker-compose.yml).
# The password ends up inside DATABASE_URL, so keep it URL safe: letters, digits, `-`, `_`, `.`, `~`.
POSTGRES_USER=manifold
POSTGRES_PASSWORD=change-me
POSTGRES_DB=manifold

# PostgreSQL connection string. Development points at the dev compose database on 127.0.0.1:5432.
# docker-compose.yml builds its own value from the POSTGRES_* variables. An external database must
# allow creating the postgis and pg_trgm extensions.
DATABASE_URL=postgres://manifold:change-me@localhost:5432/manifold

# Signs sessions and tokens. At least 32 characters, e.g. the output of `openssl rand -base64 32`.
# Changing it signs everyone out.
BETTER_AUTH_SECRET=

# 32 random bytes, base64 encoded, e.g. `openssl rand -base64 32`. Encrypts vault values. Losing it
# makes the vault unreadable; changing it requires `node cli.js vault:rotate-key`. Back it up
# separately from the database backups.
ENCRYPTION_KEY=

# Create the owner account on the first start, when the database has no user yet. Ignored (and safe
# to remove) afterwards. Username: 3 to 32 lowercase letters, digits, `.`, `_` or `-`.
# Password: at least 8 characters.
OWNER_USERNAME=owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=

# SMTP server for sign in codes, password reset codes and notices. Without SMTP_HOST, email features
# are disabled in production and mails are printed to the server console in development.
SMTP_HOST=
# 587 for STARTTLS, 465 for implicit TLS.
SMTP_PORT=587
# `true` only for implicit TLS (port 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender address, e.g. `no-reply@example.com` or `Manifold <no-reply@example.com>`. Without a display
# name, the organization name is used.
MAIL_FROM=

# Map tiles: an XYZ raster template and its attribution HTML. Default: OpenStreetMap standard tiles.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
# View used when the browser has no saved map view: `lon,lat` and a zoom level.
MAP_DEFAULT_CENTER=
MAP_DEFAULT_ZOOM=

# Where uploaded files are stored. Default /data/uploads in production, ./.data/uploads in development.
# CLI backups without a path go to `backups` next to it.
UPLOAD_DIR=
# Largest accepted upload in bytes. Default 10485760 (10 MB).
UPLOAD_MAX_BYTES=

# Days a trashed note is kept before it is deleted for good. Default 30.
TRASH_RETENTION_DAYS=
# Days audit events are kept. Default 180.
AUDIT_RETENTION_DAYS=
# Requests per minute allowed for each API key. Default 120.
API_RATE_LIMIT_PER_MINUTE=

# The client address behind a reverse proxy: the header it sets and the number of proxies in front
# of the app. docker-compose.yml uses `x-forwarded-for` and 1 when they are not set here; set both
# to nothing (`ADDRESS_HEADER=` and `XFF_DEPTH=`) to reach the container without a proxy.
# `npm run dev` ignores them.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
