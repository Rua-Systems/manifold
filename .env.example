# Copy to `.env` in this folder. The SvelteKit app (dev server and build) and docker-compose both read it.

# Public URL of the app without a trailing slash. adapter-node uses it for CSRF checks and Better Auth
# as its base URL. Use http://localhost:5173 with `npm run dev`, the real domain in production.
ORIGIN=http://localhost:5173

# PostgreSQL connection string. Locally this goes through the SSH tunnel from `db-tunnel.*`.
DATABASE_URL=postgres://user:password@localhost:5432/manifold

# Signs sessions and tokens. At least 32 random characters, e.g. the output of `openssl rand -base64 32`.
# Changing it signs everyone out.
BETTER_AUTH_SECRET=

# The only address allowed to hold an account. Its first email code sign in creates the account;
# set a password afterwards with the password reset flow.
OWNER_EMAIL=owner@example.com

# SMTP server for sign in and password reset codes. Leave SMTP_HOST empty in development to print
# the mails to the server console instead. In production no code is sent without it.
SMTP_HOST=
# 587 for STARTTLS, 465 for implicit TLS.
SMTP_PORT=587
# `true` only for implicit TLS (port 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Sender shown on outgoing mail, e.g. `Manifold <no-reply@example.com>`.
MAIL_FROM=
