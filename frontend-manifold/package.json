{
	"name": "frontend-manifold",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && vite build --config vite.cli.config.ts",
		"preview": "vite preview",
		"start": "node build",
		"cli": "node --env-file-if-exists=../.env build-cli/cli.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run test:unit -- --run && npm run test:int && npm run test:e2e",
		"test:unit": "vitest --project unit",
		"test:int": "vitest run --project integration",
		"test:e2e": "playwright install chromium && playwright test",
		"db:up": "docker compose --env-file ../.env -f ../docker-compose.dev.yml up -d --wait",
		"db:down": "docker compose --env-file ../.env -f ../docker-compose.dev.yml down",
		"db:reset": "node scripts/db-reset.ts",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/space-mono": "^5.3.0",
		"@inlang/paraglide-js": "^2.25.4",
		"@lucide/svelte": "^1.48.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tiptap/core": "^3.31.3",
		"@tiptap/extension-bubble-menu": "^3.31.3",
		"@tiptap/extension-code-block-lowlight": "^3.31.3",
		"@tiptap/extension-image": "^3.31.3",
		"@tiptap/extension-list": "^3.31.3",
		"@tiptap/extension-table": "^3.31.3",
		"@tiptap/extensions": "^3.31.3",
		"@tiptap/markdown": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24",
		"@types/nodemailer": "^8.0.2",
		"better-auth": "^1.7.6",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.3",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"highlight.js": "^11.12.0",
		"lowlight": "^3.3.0",
		"nodemailer": "^10.0.12",
		"ol": "^10.10.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sass": "^1.104.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.11",
		"zod": "^4.6.5"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true
	}
}
